# Meeting MVP Docker Compose example configuration.
# Placeholder values only. Do not put real secrets in this file.

APP_ENV=production
APP_TIMEZONE=Asia/Shanghai
PUBLIC_BASE_URL=https://meeting.youroristore.com
API_BASE_URL=https://meeting.youroristore.com/api
WS_BASE_URL=wss://meeting.youroristore.com/ws
LOG_LEVEL=INFO

CADDY_SITE_ADDRESS=meeting.youroristore.com
CADDY_ACME_EMAIL=admin@example.com

POSTGRES_DB=meeting_mvp
POSTGRES_USER=meeting_mvp
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_DATA_DIR=/opt/meeting_mvp/data/postgres

REDIS_PASSWORD=replace-with-redis-password
REDIS_DATA_DIR=/opt/meeting_mvp/data/redis

DAILY_FREE_SECONDS=2400
SESSION_MAX_SECONDS=1800
MAX_ACTIVE_SESSIONS_PER_CLIENT=1
MONTHLY_BUDGET_RMB=500
BUDGET_FUSE_RMB=400
DASHBOARD_ADMIN_TOKEN=replace-with-dashboard-admin-token
DASHBOARD_QWEN_ASR_USD_PER_SECOND=0.00009
DASHBOARD_QWEN_TEXT_INPUT_USD_PER_1M_TOKENS=0.861
DASHBOARD_QWEN_TEXT_OUTPUT_USD_PER_1M_TOKENS=3.441
DASHBOARD_USD_TO_RMB=7.2
ARCHIVE_RETENTION_DAYS=30
COS_SIGNED_URL_TTL_SECONDS=3600
SESSION_RESUME_GRACE_SECONDS=30

ASR_PROVIDER=qwen_realtime
QWEN_API_KEY=replace-with-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_ASR_MODEL=qwen3-asr-flash-realtime
QWEN_ASR_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_ASR_SAMPLE_RATE_HZ=16000
QWEN_ASR_AUDIO_FORMAT=pcm
QWEN_ASR_LANGUAGE=auto
QWEN_INTERIM_MODEL=replace-with-qwen-interim-model
QWEN_INTERIM_ENABLED=true
QWEN_FINAL_MODEL=qwen3.6-max-preview

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_FINAL_MODEL=
OPENAI_STT_ENABLED=false
OPENAI_STT_MODEL=

TENCENT_COS_SECRET_ID=replace-with-cos-secret-id
TENCENT_COS_SECRET_KEY=replace-with-cos-secret-key
TENCENT_COS_REGION=replace-with-cos-region
TENCENT_COS_BUCKET=replace-with-cos-bucket
TENCENT_COS_EXPORT_PREFIX=exports/
